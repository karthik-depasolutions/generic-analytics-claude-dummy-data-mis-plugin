{
  "kind": "postgres",
  "connection": {
    "duckdb_attach_sql": [
      "INSTALL postgres; LOAD postgres;",
      "ATTACH '${FORGE_SOURCE_DB_URL}' AS srcdb (TYPE POSTGRES, READ_ONLY)"
    ],
    "read_only": true
  },
  "tables": [
    {
      "name": "checkpoint_blobs",
      "physical_ref": "srcdb.\"public\".\"checkpoint_blobs\"",
      "columns": [
        "thread_id",
        "checkpoint_ns",
        "channel",
        "version",
        "type",
        "blob"
      ]
    },
    {
      "name": "checkpoint_migrations",
      "physical_ref": "srcdb.\"public\".\"checkpoint_migrations\"",
      "columns": [
        "v"
      ]
    },
    {
      "name": "checkpoint_writes",
      "physical_ref": "srcdb.\"public\".\"checkpoint_writes\"",
      "columns": [
        "thread_id",
        "checkpoint_ns",
        "checkpoint_id",
        "task_id",
        "idx",
        "channel",
        "type",
        "blob",
        "task_path"
      ]
    },
    {
      "name": "checkpoints",
      "physical_ref": "srcdb.\"public\".\"checkpoints\"",
      "columns": [
        "thread_id",
        "checkpoint_ns",
        "checkpoint_id",
        "parent_checkpoint_id",
        "type",
        "checkpoint",
        "metadata"
      ]
    }
  ]
}
